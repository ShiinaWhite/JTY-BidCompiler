{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jty.local/schemas/requirements.schema.json",
  "title": "requirements.json —— 投标要求矩阵",
  "description": "从招标文件抽取的每一条要求。所有资格条件必须保留招标原文（source_text），不允许改写后丢掉原文。",
  "type": "object",
  "required": ["schema_version", "source_document", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "source_document": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "pages": { "type": "integer" }
      }
    },
    "generated_at": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/Requirement" }
    },
    "extraction_issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "抽取过程中的告警（例如某条锚点未命中）。非空即需要人工确认，不可静默忽略。"
    }
  },
  "$defs": {
    "Requirement": {
      "type": "object",
      "required": [
        "id", "chapter", "source_text", "requirement_type", "severity",
        "condition", "evidence_required", "response_location", "source_page", "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定编号，形如 QUAL-3-1 / QUAL-143-13 / SCORE-BIZ-PERF / COMM-1",
          "pattern": "^[A-Z][A-Z0-9-]{2,}$"
        },
        "chapter": { "type": "string", "description": "所属章节，如 '第一章 招标公告'" },
        "source_text": { "type": "string", "description": "招标原文（逐字，不得改写）" },
        "requirement_type": {
          "type": "string",
          "enum": ["QUALIFICATION", "PERFORMANCE", "FINANCIAL", "PERSONNEL", "CREDIT", "COMMERCIAL", "TECHNICAL", "FORMAT", "OTHER"]
        },
        "severity": {
          "type": "string",
          "enum": ["HARD", "SCORE", "NORMAL", "INFO"],
          "description": "HARD=不满足即否决；SCORE=影响评分；NORMAL=需响应；INFO=仅记录"
        },
        "condition": {
          "description": "机器可判的满足条件（结构化）；无法结构化时为 null + condition_text",
          "type": ["object", "null"]
        },
        "condition_text": { "type": ["string", "null"], "description": "条件的自然语言表述" },
        "evidence_required": {
          "type": "array",
          "description": "需提供的证明材料类别（与 materials.category 对齐）",
          "items": { "type": "string" }
        },
        "response_location": {
          "type": "string",
          "description": "应放在投标文件哪一章（第六章格式顺序，如 '六（二）资格要求2'）"
        },
        "source_page": { "type": "integer", "minimum": 1 },
        "source_section": { "type": ["string", "null"] },
        "source_quote": { "type": ["string", "null"], "description": "定位用的最小原文片段" },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "EVIDENCE_INSUFFICIENT", "WAIT_COMPANY", "NOT_EVALUATED"],
          "description": "由 matcher 写入；parser 只写 NOT_EVALUATED"
        },
        "evaluated_by": {
          "type": ["string", "null"],
          "enum": [null, "RULE", "RULE+MANUAL", "MANUAL", "NOT_EVALUATED"]
        },
        "matched_materials": {
          "type": "array",
          "items": { "type": "string" },
          "description": "候选材料 id（matcher 写入）"
        },
        "verdict_reason": { "type": ["string", "null"] },
        "evidence_chain": {
          "type": "array",
          "description": "判定所依据的原文引用链；只有结论没有引用视为不合格",
          "items": {
            "type": "object",
            "required": ["claim", "quote", "material_id"],
            "properties": {
              "claim": { "type": "string" },
              "quote": { "type": "string" },
              "material_id": { "type": "string" },
              "source_ref": { "type": ["string", "null"] },
              "source_page": { "type": ["integer", "null"] }
            }
          }
        },
        "missing_info": {
          "type": "array",
          "items": { "type": "string" },
          "description": "缺失信息/待公司确认项"
        },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
